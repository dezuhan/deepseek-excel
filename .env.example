# Copy this file to .env (scripts/setup.ps1 does it automatically).
# Never commit the .env file that holds the real key.

# DeepSeek API key (required). Example: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=

# Default model. Current official options: deepseek-flash (fast/cheap), deepseek-v4-pro (higher quality)
DEEPSEEK_MODEL=deepseek-flash

# OpenAI-compatible DeepSeek base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local server port (must match manifest.xml and the task pane SourceLocation)
PORT=3000

# Cell limits per operation
MAX_CELLS_PER_WRITE=5000
MAX_CELLS_PER_READ=2000

# Tool iterations per chat turn
MAX_TOOL_ITERATIONS=12

# Set to 1 to use the mock LLM (UI development without calling DeepSeek)
MOCK_LLM=0

# Set to 1 for verbose logging (the API key is always redacted)
DEBUG_LOG=0
