[
  {
    "type": "function",
    "function": {
      "name": "get_workbook_overview",
      "description": "Overview of the active workbook: sheet list, used-range dimensions, detected headers, sample rows, tables, and charts. ALWAYS call this first before guessing a sheet layout.",
      "parameters": {
        "type": "object",
        "properties": {
          "includeSampleRows": {
            "type": "integer",
            "description": "Number of sample rows per sheet (0-5). Default 3.",
            "minimum": 0,
            "maximum": 5
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "read_range",
      "description": "Read a range: values, formulas, and number formats. Use A1 notation (for example 'A1:D20'). The maximum number of cells is capped by the server configuration.",
      "parameters": {
        "type": "object",
        "properties": {
          "sheet": { "type": "string", "description": "Worksheet name, for example 'Sheet1'." },
          "address": { "type": "string", "description": "A1-style range address without the sheet name, for example 'A1:D20'." },
          "includeFormulas": { "type": "boolean", "description": "Include formulas (default true)." },
          "maxCells": { "type": "integer", "description": "Maximum number of cells to read." }
        },
        "required": ["sheet", "address"],
        "additionalProperties": false
      }
    }
  },
