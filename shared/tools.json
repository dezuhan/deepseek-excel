        },
        "required": ["sheet", "address"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "conditional_format",
      "description": "Add simple conditional formatting to a range (requires ExcelApi 1.6).",
      "parameters": {
        "type": "object",
        "properties": {
          "sheet": { "type": "string" },
          "address": { "type": "string" },
          "type": { "type": "string", "enum": ["cellValue", "colorScale", "dataBar"] },
          "operator": {
            "type": "string",
            "enum": ["GreaterThan", "GreaterThanOrEqual", "LessThan", "LessThanOrEqual", "EqualTo", "NotEqualTo", "Between"],
            "description": "For type='cellValue'."
          },
          "formula1": { "type": "string", "description": "First comparison value, for example '1000'." },
          "formula2": { "type": "string", "description": "Second comparison value for the Between operator." },
          "fillColor": { "type": "string", "description": "Resulting fill color, for example '#FEE2E2'." },
          "fontColor": { "type": "string", "description": "Resulting font color." }
        },
        "required": ["sheet", "address", "type"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "find_replace",
