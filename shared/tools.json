  {
    "type": "function",
    "function": {
      "name": "write_range",
      "description": "Write values OR formulas into a range. mode='formulas' uses en-US syntax (for example '=SUM(A1:A5)'). Changes are NOT applied immediately: a plan card appears and the user must approve it.",
      "parameters": {
        "type": "object",
        "properties": {
          "sheet": { "type": "string" },
          "address": { "type": "string", "description": "A1-style range address, for example 'B2:D10'." },
          "mode": { "type": "string", "enum": ["values", "formulas"], "description": "values for plain data, formulas for Excel formulas." },
          "values": {
            "type": "array",
            "description": "2D matrix of rows x columns matching the range dimensions.",
            "items": { "type": "array", "items": { "type": ["string", "number", "boolean", "null"] } }
          },
          "numberFormat": {
            "type": "string",
            "description": "Optional number format for the whole range, for example '#,##0' or 'dd/mm/yyyy'."
          }
        },
        "required": ["sheet", "address", "mode", "values"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "write_table_rows",
      "description": "Append or overwrite data rows of an Excel table (ListObject) identified by table name.",
      "parameters": {
        "type": "object",
        "properties": {
          "sheet": { "type": "string" },
          "tableName": { "type": "string" },
          "rows": {
            "type": "array",
            "items": { "type": "array", "items": { "type": ["string", "number", "boolean", "null"] } }
          },
          "append": { "type": "boolean", "description": "true appends at the end of the table (default), false overwrites from the first data row." }
        },
        "required": ["sheet", "tableName", "rows"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "format_range",
      "description": "Change the formatting of a range: bold, italic, font size, font color, fill color, number format, alignment, wrap text, column width, row height.",
      "parameters": {
        "type": "object",
        "properties": {
          "sheet": { "type": "string" },
          "address": { "type": "string" },
          "bold": { "type": "boolean" },
          "italic": { "type": "boolean" },
          "fontSize": { "type": "number" },
          "fontColor": { "type": "string", "description": "Hex color, for example '#1F2937'." },
          "fillColor": { "type": "string", "description": "Hex fill color, for example '#FEF3C7'." },
          "numberFormat": { "type": "string" },
          "horizontalAlignment": { "type": "string", "enum": ["Left", "Center", "Right"] },
          "verticalAlignment": { "type": "string", "enum": ["Top", "Center", "Bottom"] },
          "wrapText": { "type": "boolean" },
          "columnWidth": { "type": "number", "description": "Column width in Excel units." },
          "rowHeight": { "type": "number", "description": "Row height in points." }
        },
        "required": ["sheet", "address"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "clear_range",
