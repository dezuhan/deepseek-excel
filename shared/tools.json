        "type": "object",
        "properties": {
          "sheet": { "type": "string" },
          "address": { "type": "string" },
          "applyTo": { "type": "string", "enum": ["all", "contents", "formats"], "description": "Default 'all'." }
        },
        "required": ["sheet", "address"],
        "additionalProperties": false
      }
    }
  },
